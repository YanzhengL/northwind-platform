# Terraform
# Provider plugins and module cache
.terraform/
# Local state (only exists before migrating to S3). Never commit state.
*.tfstate
*.tfstate.*
# Saved plan files can contain sensitive values
*.tfplan
tfplan
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraform.tfstate.lock.info
# Keep the provider lock file committed: .terraform.lock.hcl

# Secrets and local config - never commit
*.tfvars
!*.example.tfvars
.env
.env.*
!.env.example
*.pem
*.key
kubeconfig*
.aws/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/

# Editors and OS
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Diagram build artefacts (the PNGs are committed, the .gv sources are not)
docs/diagrams/*.gv
docs/roadmap-daily-plan.md
docs/interview/*.md

# Backend settings with environment-specific values (bucket name contains account ID)
*.tfbackend
